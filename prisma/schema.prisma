generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An application user. No auth/login yet — just the record.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A stored OAuth connection to an external provider (Notion, Slack, Fireflies, ...).
model IntegrationConnection {
  id            String   @id @default(uuid())
  provider      String
  workspaceId   String?
  workspaceName String?
  botId         String?
  accessToken   String
  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, workspaceId])
}

/// Short-lived CSRF state issued at the start of an OAuth flow and verified on callback.
model OAuthState {
  id        String    @id @default(uuid())
  state     String    @unique
  provider  String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}
