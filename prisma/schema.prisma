generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProviderName {
  NOTION          @map("notion")
  SLACK           @map("slack")
  JIRA            @map("jira")
  CLICKUP         @map("clickup")
  GOOGLE_CALENDAR @map("google_calendar")
  GMAIL           @map("gmail")
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  DEGRADED
  REAUTH_REQUIRED
  REVOKED
}

enum SourceObjectType {
  TASK
  DOCUMENT
  MESSAGE
  EMAIL_THREAD
  MEETING
  DECISION
  COMMITMENT
  PERSON
  PROJECT
}

enum NormalizedWorkStatus {
  UNKNOWN
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum SourceVisibility {
  PRIVATE
  ORGANIZATION
  RESTRICTED
}

enum WorkRelationType {
  BLOCKS
  DEPENDS_ON
  MENTIONS
  BELONGS_TO
  DECIDED_IN
  ASSIGNED_TO
  FOLLOWS_UP
  CONFLICTS_WITH
  RELATES_TO
}

enum SyncStatus {
  IDLE
  RUNNING
  FAILED
  REQUIRES_FULL_SYNC
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ActionRisk {
  READ
  DRAFT
  WRITE
  SEND
  DESTRUCTIVE
}

enum ActionStatus {
  PROPOSED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  SUCCEEDED
  FAILED
  VERIFICATION_FAILED
  EXPIRED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  VERIFIED
  VERIFICATION_FAILED
}

enum DeliveryChannel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum AuditActorType {
  USER
  AGENT
  SYSTEM
  PROVIDER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  connections      IntegrationConnection[]
  oauthStates      OAuthState[]
  sourceObjects    SourceObject[]
  evidence         Evidence[]
  agentDefinitions AgentDefinition[]
  agentRuns        AgentRun[]
  actionProposals  ActionProposal[]
  reports          Report[]
  auditEvents      AuditEvent[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  connections      IntegrationConnection[]
  oauthStates      OAuthState[]
  sourceObjects    SourceObject[]
  evidence         Evidence[]
  agentDefinitions AgentDefinition[]
  agentRuns        AgentRun[]
  proposedActions  ActionProposal[]
  approvals        Approval[]
  reports          Report[]
  auditEvents      AuditEvent[]
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model IntegrationConnection {
  id                    String           @id @default(uuid())
  organizationId        String
  userId                String
  provider              ProviderName
  accountId             String
  accountName           String?
  workspaceId           String?
  workspaceName         String?
  botId                 String?
  status                ConnectionStatus @default(ACTIVE)
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  grantedScopes         String[]
  credentialKeyVersion  Int              @default(1)
  credentialGroupId     String?
  metadata              Json?
  lastSuccessfulSyncAt  DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncCursors     SyncCursor[]
  sourceObjects   SourceObject[]
  actionProposals ActionProposal[]

  @@unique([userId, provider, accountId])
  @@index([organizationId, userId, status])
  @@index([provider, status])
  @@index([userId, provider, credentialGroupId])
}

model OAuthState {
  id             String       @id @default(uuid())
  state          String       @unique
  provider       ProviderName
  userId         String
  organizationId String
  redirectUri    String?
  codeVerifier   String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([expiresAt])
}

model SyncCursor {
  id               String     @id @default(uuid())
  connectionId     String
  scope            String
  cursor           String?
  metadata         Json?
  status           SyncStatus @default(IDLE)
  lastAttemptAt    DateTime?
  lastSuccessfulAt DateTime?
  lastError        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, scope])
  @@index([status, lastAttemptAt])
}

model SourceObject {
  id               String               @id @default(uuid())
  organizationId   String
  userId           String
  connectionId     String
  provider         ProviderName
  nativeId         String
  type             SourceObjectType
  title            String
  summary          String?
  nativeStatus     String?
  normalizedStatus NormalizedWorkStatus @default(UNKNOWN)
  priority         Int?
  sourceUrl        String?
  authors          Json?
  assignees        Json?
  attendees        Json?
  metadata         Json?
  contentHash      String?
  visibility       SourceVisibility     @default(PRIVATE)
  nativeCreatedAt  DateTime?
  nativeUpdatedAt  DateTime?
  dueAt            DateTime?
  startAt          DateTime?
  endAt            DateTime?
  syncedAt         DateTime             @default(now())
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  evidence          Evidence[]
  outgoingRelations WorkRelation[]        @relation("RelationSource")
  incomingRelations WorkRelation[]        @relation("RelationTarget")

  @@unique([connectionId, nativeId])
  @@index([organizationId, userId, type, deletedAt])
  @@index([organizationId, normalizedStatus, dueAt])
  @@index([provider, nativeUpdatedAt])
}

model WorkRelation {
  id             String           @id @default(uuid())
  sourceObjectId String
  targetObjectId String
  type           WorkRelationType
  confidence     Float?
  inferred       Boolean          @default(false)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sourceObject SourceObject @relation("RelationSource", fields: [sourceObjectId], references: [id], onDelete: Cascade)
  targetObject SourceObject @relation("RelationTarget", fields: [targetObjectId], references: [id], onDelete: Cascade)

  @@unique([sourceObjectId, targetObjectId, type])
  @@index([targetObjectId, type])
}

model Evidence {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  sourceObjectId String
  excerpt        String?
  sourceVersion  String?
  metadata       Json?
  observedAt     DateTime  @default(now())
  validUntil     DateTime?
  createdAt      DateTime  @default(now())

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceObject  SourceObject        @relation(fields: [sourceObjectId], references: [id], onDelete: Cascade)
  runReferences EvidenceReference[]

  @@index([organizationId, userId, observedAt])
  @@index([sourceObjectId])
}

model AgentDefinition {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  name           String
  description    String?
  instructions   String
  triggerType    AgentTriggerType @default(MANUAL)
  scheduleCron   String?
  timezone       String?
  enabled        Boolean          @default(true)
  autonomyLevel  Int              @default(0)
  allowedTools   String[]
  sourcePolicy   Json?
  deliveryPolicy Json?
  modelPolicy    Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs         AgentRun[]

  @@index([organizationId, userId, enabled])
}

model AgentRun {
  id                String         @id @default(uuid())
  organizationId    String
  userId            String
  agentDefinitionId String?
  kind              String
  status            AgentRunStatus @default(QUEUED)
  input             Json?
  result            Json?
  errorCode         String?
  errorMessage      String?
  modelProvider     String?
  model             String?
  promptTokens      Int?
  outputTokens      Int?
  estimatedCostUsd  Decimal?       @db.Decimal(12, 6)
  queuedAt          DateTime       @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentDefinition    AgentDefinition?    @relation(fields: [agentDefinitionId], references: [id], onDelete: SetNull)
  evidenceReferences EvidenceReference[]
  actionProposals    ActionProposal[]
  report             Report?

  @@index([organizationId, userId, status, createdAt])
  @@index([agentDefinitionId, createdAt])
}

model EvidenceReference {
  id         String   @id @default(uuid())
  agentRunId String
  evidenceId String
  claimKey   String?
  createdAt  DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, evidenceId, claimKey])
  @@index([evidenceId])
}

model ActionProposal {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  agentRunId     String?
  connectionId   String
  provider       ProviderName
  operation      String
  targetRef      Json
  payload        Json
  payloadHash    String
  preview        String
  risk           ActionRisk
  status         ActionStatus @default(PROPOSED)
  idempotencyKey String       @unique
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?             @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  approvals    Approval[]
  execution    ActionExecution?

  @@index([organizationId, userId, status, createdAt])
  @@index([connectionId, status])
}

model Approval {
  id               String           @id @default(uuid())
  actionProposalId String
  approverUserId   String
  decision         ApprovalDecision
  proposalHash     String
  reason           String?
  decidedAt        DateTime         @default(now())

  actionProposal ActionProposal @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  approver       User           @relation(fields: [approverUserId], references: [id], onDelete: Restrict)

  @@unique([actionProposalId, approverUserId])
  @@index([approverUserId, decidedAt])
}

model ActionExecution {
  id               String          @id @default(uuid())
  actionProposalId String          @unique
  status           ExecutionStatus @default(PENDING)
  attempts         Int             @default(0)
  providerReceipt  Json?
  verification     Json?
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  actionProposal ActionProposal @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
}

model Report {
  id             String    @id @default(uuid())
  organizationId String
  ownerUserId    String
  agentRunId     String    @unique
  type           String
  title          String
  content        Json
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  agentRun     AgentRun               @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([organizationId, ownerUserId, createdAt])
}

model NotificationDelivery {
  id                String          @id @default(uuid())
  reportId          String
  channel           DeliveryChannel
  recipient         String
  status            DeliveryStatus  @default(PENDING)
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  attemptedAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, status])
}

model AuditEvent {
  id             String         @id @default(uuid())
  organizationId String
  actorUserId    String?
  actorType      AuditActorType
  action         String
  resourceType   String
  resourceId     String?
  requestId      String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}
