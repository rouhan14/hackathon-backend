# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real secrets.

# --- Notion OAuth ---
# From your Notion integration: https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
# Must exactly match a redirect URI configured on the Notion integration.
NOTION_REDIRECT_URI=http://localhost:5000/auth/notion/callback
# Frontend URL the callback bounces back to after connecting (a `notion=connected|error` param is appended).
NOTION_POST_AUTH_REDIRECT=http://localhost:3000/dashboard

# --- Jira via Atlassian Rovo MCP ---
# This is a machine-facing MCP endpoint. The frontend must call GET /auth/jira
# and navigate to the authorizationUrl returned by the backend.
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/mcp/authv2
JIRA_REDIRECT_URI=http://localhost:5000/auth/jira/callback
JIRA_POST_AUTH_REDIRECT=http://localhost:3000/dashboard

# --- Slack OAuth ---
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_OAUTH_REDIRECT=http://localhost:5000/auth/slack/callback
SLACK_POST_AUTH_REDIRECT=http://localhost:3000/dashboard

# --- Provider credential encryption ---
# Generate 32 random bytes and store them as base64 or 64-character hex.
# Changing this key requires a credential re-encryption migration.
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# --- Database ---
# Local Postgres via docker-compose.yml (host port 5433 -> container 5432).
DATABASE_URL="postgresql://postgres:dev@localhost:5433/hackathon?schema=public"

# --- Auth (JWT) ---
# Use a long random string in real environments.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- CORS ---
# Comma-separated allowed origins. Leave unset to reflect the request origin (dev only).
CORS_ORIGIN=http://localhost:3000

# --- Amazon Bedrock ---
# Option A (recommended if you have IAM keys): Converse API with SigV4
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
# Required when the access key is temporary (usually starts with ASIA).
# AWS_SESSION_TOKEN=your-temporary-session-token
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=google.gemma-3-4b-it
# IAM user needs permission to invoke the model in this region.
# For IAM roles, ECS/EKS/EC2 credentials, profiles, or web identity, omit the
# explicit keys above and set BEDROCK_USE_AWS_CREDENTIAL_CHAIN=true.
#
# Option B (Mantle OpenAI-compatible): Bedrock console long-term API key only
# (do NOT put an AKIA… IAM access key here)
# BEDROCK_API_KEY=your-bedrock-console-api-key
# BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
#
# Optional: max completion tokens (default 2048)
# BEDROCK_MAX_TOKENS=2048
