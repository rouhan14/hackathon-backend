# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real secrets.

# --- Notion OAuth ---
# From your Notion integration: https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
# Must exactly match a redirect URI configured on the Notion integration.
NOTION_REDIRECT_URI=http://localhost:5000/auth/notion/callback
# Frontend URL the callback bounces back to after connecting (a `notion=connected|error` param is appended).
NOTION_POST_AUTH_REDIRECT=http://localhost:3000/dashboard

# --- Database ---
# Local Postgres via docker-compose.yml (host port 5433 -> container 5432).
DATABASE_URL="postgresql://postgres:dev@localhost:5433/hackathon?schema=public"

# --- Auth (JWT) ---
# Use a long random string in real environments.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- CORS ---
# Comma-separated allowed origins. Leave unset to reflect the request origin (dev only).
CORS_ORIGIN=http://localhost:3000
